# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Downloaded dataset (large binary files, ~250 MB total) ───────────────────
# Re-downloadable via svhn_classifier.py from Stanford UFLDL
data/train_32x32.mat
data/test_32x32.mat
data/extra_32x32.mat

# Keep normalisation stats (tiny, needed for inference without retraining)
!data/norm_mean.npy
!data/norm_std.npy

# ── Trained model weights (large binary files) ────────────────────────────────
# Regenerated by running svhn_classifier.py
models/svhn_model.keras
models/svhn_best.keras

# Keep training artefacts that are small and human-readable
!models/training_log.csv
!models/training_results.png

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Jupyter / IPython ─────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Build / dist ──────────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ── Logs and temp files ───────────────────────────────────────────────────────
*.log
*.tmp
*.bak

data/
models/
